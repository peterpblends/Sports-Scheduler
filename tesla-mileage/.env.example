# Mile Ledger configuration. Copy to .env and edit; every line is optional.

# --- Where the app listens -------------------------------------------------
# 127.0.0.1 means only this machine can reach it. Change it only after setting
# a passcode below.
MILE_LEDGER_HOST=127.0.0.1
PORT=8730

# Public base URL, if you are reaching the app from elsewhere. Used for the
# accountant's share link and for the Tesla OAuth redirect.
# MILE_LEDGER_BASE_URL=https://mileage.example.com

# --- Your data -------------------------------------------------------------
# The whole ledger is this one file. Back it up and you have backed up
# everything.
# MILE_LEDGER_DB=./data/mileage.db

# IANA time zone. Decides which calendar day (and tax year) a trip falls in.
# MILE_LEDGER_TZ=America/Chicago

# --- Access ----------------------------------------------------------------
# Set a passcode before exposing the app past this machine. You can also set it
# from the Settings page, which stores it hashed in the database instead.
# MILE_LEDGER_PASSCODE=

# --- How vehicle data arrives ---------------------------------------------
# manual (import files only) | demo (simulated car) | fleet (official Tesla API)
# | owner (older Tesla interface, needs only a refresh token)
MILE_LEDGER_CONNECTOR=manual

# Official Fleet API application, from developer.tesla.com. Needed only for
# MILE_LEDGER_CONNECTOR=fleet.
# TESLA_CLIENT_ID=
# TESLA_CLIENT_SECRET=
# TESLA_REDIRECT_URI=https://mileage.example.com/callback
# TESLA_AUDIENCE=https://fleet-api.prd.na.vn.cloud.tesla.com
# TESLA_SCOPES=openid offline_access vehicle_device_data vehicle_location

# Ceiling on estimated Tesla API credits per calendar month. The poller slows
# down rather than crossing it. Tesla's included monthly allowance is worth
# roughly 10,000 credits at the time of writing, so this leaves headroom.
MILE_LEDGER_CREDIT_BUDGET=8000

# --- Street addresses ------------------------------------------------------
# Turn coordinates into addresses using OpenStreetMap's free Nominatim service.
# Set to 0 to keep every coordinate on this machine.
MILE_LEDGER_GEOCODE=1
# A contact address is good manners for the OSM service, and optional.
# MILE_LEDGER_GEOCODE_CONTACT=you@example.com

# debug | info | warn | error
MILE_LEDGER_LOG=info
