# Run the ledger as a service on a machine that stays on — a spare box, a
# Raspberry Pi, or an always-free cloud VM.
#
#   sudo cp deploy/mile-ledger.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mile-ledger
#   journalctl -u mile-ledger -f
#
# Adjust User, WorkingDirectory and the node path to match the machine.

[Unit]
Description=Mile Ledger — Tesla business mileage ledger
Documentation=https://github.com/peterpblends/mile-ledger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mileledger
Group=mileledger
WorkingDirectory=/opt/mile-ledger
Environment=NODE_OPTIONS=--no-warnings=ExperimentalWarning
Environment=MILE_LEDGER_HOST=127.0.0.1
Environment=PORT=8730
Environment=MILE_LEDGER_DB=/var/lib/mile-ledger/mileage.db
Environment=MILE_LEDGER_TZ=America/Chicago
# Set these before exposing the app past this machine.
# Environment=MILE_LEDGER_PASSCODE=change-me
# Environment=MILE_LEDGER_SECRET=a-long-random-string
ExecStart=/usr/bin/node src/index.ts
Restart=on-failure
RestartSec=10

# The app needs its data directory and nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mile-ledger
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=512M

[Install]
WantedBy=multi-user.target
