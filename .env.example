# Postgres connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scheduler?schema=public"

# Separate database used by `npm test`. Tests truncate tables, never point this
# at a database you care about.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scheduler_test?schema=public"

# Absolute origin, used to build links in invitation / password-reset emails.
APP_URL="http://localhost:3000"

# Session cookie lifetime in days.
SESSION_TTL_DAYS=30

# Mail transport: "console" writes messages to .mail/ and stdout, "smtp" sends.
MAIL_TRANSPORT=console
MAIL_FROM="Sports Scheduler <no-reply@example.com>"
SMTP_URL=""

# How many reverse proxies sit in front of the app.
#
# X-Forwarded-For is a list each hop appends to, so the leftmost entry is whatever
# the caller chose to send. The address is taken this many places from the RIGHT —
# the end your own proxy wrote. 1 is correct behind Vercel or a single nginx.
#
# Set to 0 when nothing is in front: the header is then ignored rather than believed,
# which stops a caller writing arbitrary values into audit rows and session records
# and stops them defeating per-IP rate limits by varying a header.
TRUSTED_PROXY_HOPS=1
